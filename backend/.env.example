# Local development only. Generate a real key using the README command.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# Generate independently of DJANGO_SECRET_KEY. Never commit real keys.
JWT_SIGNING_KEY=replace-with-a-generated-jwt-signing-key
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
AUTH_REGISTER_RATE=5/hour
AUTH_LOGIN_RATE=10/minute
AUTH_REFRESH_RATE=30/minute
AUTH_LOGOUT_RATE=30/minute
PROBLEM_REQUEST_RATE=60/minute
CONVERSATION_REQUEST_RATE=120/minute
API_MAX_BODY_BYTES=65536
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_CHARACTERS=24000
# Optional until AI endpoints are used. Put a real key only in ignored .env.
GROQ_API_KEY=
# Account access is required; process environment overrides this .env value.
GROQ_MODEL=openai/gpt-oss-120b
# Sent only for GPT-OSS models; hidden reasoning still consumes completion tokens.
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_COMPLETION_TOKENS=2048
AI_REQUEST_RATE=10/minute
AI_DAILY_REQUEST_LIMIT=50
AI_MAX_PROMPT_CHARACTERS=60000
AI_LEASE_SECONDS=120
# Future PostgreSQL settings (driver not installed yet):
# DB_ENGINE=postgresql
# DB_NAME=student_buddy
# DB_USER=replace-with-database-user
# DB_PASSWORD=replace-with-database-password
# DB_HOST=replace-with-database-host
# DB_PORT=5432
# DB_SSLMODE=require
